# Copy to .env and fill in from Supabase Studio > Project Settings > API
# Project: CivicTrace (ref: dqkxccbvffoqelwwwctu, region: ap-northeast-1)
SUPABASE_URL=https://dqkxccbvffoqelwwwctu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...paste-service-role-key-for-dqkxccbvffoqelwwwctu...
PORT=4000
# Frontend URL(s) allowed by CORS, comma-separated. Put your deployed frontend link here.
# Local dev (localhost:8443/5173/3000) is always allowed; no need to list it.
FRONTEND_URL=http://localhost:8443

# --- Email OTP auth (real emails like production websites) ---
# Without these, OTPs are printed to the backend console and (in dev)
# returned as `debugOtp` so signup/login still work end-to-end.
# Gmail example: create a 16-char App Password (Google Account > Security >
# 2-Step Verification > App passwords), then:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# SMTP_FROM=CivicTrace <you@gmail.com>
# OTP_DEBUG=true   # show OTP in API response when email sending is off (dev only)

# --- Optional Web3 anchor (additive, disabled by default — deployed site unchanged when off) ---
# ONCHAIN_ENABLED=true
# RPC_URL=https://sepolia.base.org
# CHAIN_ID=84532
# CONTRACT_ADDRESS=0xYourDeployedCivicTraceAddress
# ANCHOR_PRIVATE_KEY=0xYourServerKeyWithFaucetFunds
# EXPLORER_URL=https://sepolia.basescan.org
